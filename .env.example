# Copy to .env and fill in. Everything is optional: without a key GraphAgentDB runs offline
# with deterministic fallbacks for extraction, embeddings and answers.
GEMINI_API_KEY=

# GRAPHAGENTDB_DATA_DIR=data
# GRAPHAGENTDB_GEMINI_MODEL=gemini-2.5-flash
# GRAPHAGENTDB_EMBED_MODEL=gemini-embedding-001
# GRAPHAGENTDB_EMBED_DIM=768
# GRAPHAGENTDB_CONFLICT_SIMILARITY_THRESHOLD=0.85
# GRAPHAGENTDB_CONTEXT_FILENAME=GEMINI.md
# GRAPHAGENTDB_USE_AGENT_HARNESS=false
